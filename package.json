{
  "name": "student-information-system",
  "version": "1.0.0",
  "description": "A complete Student Information System for colleges and universities",
  "main": "server/app.js",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "start": "node server/app.js",
    "dev": "nodemon server/app.js",
    "seed": "node server/db/seed.js",
    "init": "node server/db/seed.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",

    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "multer": "^2.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
